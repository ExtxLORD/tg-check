# ===== Почта (IMAP, read-only) =====
# Для @fa.ru вероятный сервер: mx.fa.ru (порт 993).
# Если не подключится — уточните у администратора/в настройках почтового клиента.
IMAP_HOST=mx.fa.ru
IMAP_PORT=993
MAIL_LOGIN=your.login@fa.ru
MAIL_PASSWORD=your_password_or_app_password

# ===== Telegram =====
# Токен от @BotFather
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# Ваш chat id (как узнать — в README)
TG_CHAT_ID=123456789

# ===== Поведение =====
# Автопроверка, секунд (минимум 30). 300 = раз в 5 минут.
CHECK_INTERVAL=300
# Папка на почте
IMAP_FOLDER=INBOX
# Максимум писем за одну проверку (защита от потока, если долго не заходили)
MAX_PER_CHECK=25
# Максимальный размер вложения в МБ для отправки в Telegram (лимит API — 50)
MAX_ATTACHMENT_MB=50
